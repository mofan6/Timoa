import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
export { Theme }

import "../assets/fonts/SarasaUiSC-Regular.ttf";
import "../assets/fonts/SarasaUiSC-Bold.ttf";

// Keep the bundled language signal and use the actual Regular/Bold font faces.
export global Typography {
    private property<string> language-family: @tr("Microsoft YaHei UI");
    out property<string> body-family: self.language-family == self.latin-family ? self.latin-family : "Timoa Sarasa UI SC";
    out property<string> latin-family: "Segoe UI";
    out property<bool> cjk: self.body-family != self.latin-family;
    // Sarasa UI SC ships its own Bold face at 700.
    out property<int> emphasis-weight: self.cjk ? 700 : 600;
    out property<length> heading-size: 15px;
    out property<length> control-size: self.cjk ? 14px : 13px;
    out property<length> caption-size: self.cjk ? 12px : 11px;
    out property<length> small-size: self.cjk ? 11px : 10px;
}


// Only in-page branding follows the theme. The native window/executable icon
// continues to use the original asset in both modes.
export component AppLogo inherits Image {
    source: Theme.variant == 1 ? (Theme.dark ? @image-url("../assets/themes/blue-dark.svg") : @image-url("../assets/themes/blue-light.svg"))
        : Theme.variant == 2 ? (Theme.dark ? @image-url("../assets/themes/bamboo-dark.svg") : @image-url("../assets/themes/bamboo-light.svg"))
        : Theme.variant == 3 ? (Theme.dark ? @image-url("../assets/themes/violet-dark.svg") : @image-url("../assets/themes/violet-light.svg"))
        : Theme.variant == 4 ? (Theme.dark ? @image-url("../assets/themes/rose-dark.svg") : @image-url("../assets/themes/rose-light.svg"))
        : Theme.variant == 5 ? (Theme.dark ? @image-url("../assets/themes/amber-dark.svg") : @image-url("../assets/themes/amber-light.svg"))
        : Theme.dark ? @image-url("../assets/logo.svg") : @image-url("../assets/logo-light.svg");
}

export component PageScroll inherits ScrollView {
    horizontal-scrollbar-policy: always-off;
    mouse-drag-pan-enabled: false;
    content-width: self.width;
    VerticalLayout {
        padding-right: 20px;
        @children
    }
}

export component InfoTip inherits Rectangle {
    callback hint-hover(bool);
    property<bool> hint-shown: false;
    // A small mark with a generous hover region; the visual size is independent
    // from the hit target so the explanation does not require pixel hunting.
    width: 30px; height: 30px;
    Rectangle {
        x: (parent.width - 12px) / 2; y: (parent.height - 12px) / 2;
        width: 12px; height: 12px; border-radius: 6px; border-width: 0.85px;
        border-color: hover.has-hover ? Theme.accent-text : Theme.faint;
        Rectangle { x: 5.4px; y: 2.8px; width: 1.2px; height: 4px; border-radius: 0.6px;
            background: hover.has-hover ? Theme.accent-text : Theme.faint; }
        Rectangle { x: 5.4px; y: 8.1px; width: 1.2px; height: 1.2px; border-radius: 0.6px;
            background: hover.has-hover ? Theme.accent-text : Theme.faint; }
    }
    Timer {
        interval: 100ms;
        running: hover.has-hover && !root.hint-shown;
        triggered => { root.hint-shown = true; root.hint-hover(true); }
    }
    hover := TouchArea {
        mouse-cursor: help;
        changed has-hover => {
            if (!self.has-hover) { root.hint-shown = false; root.hint-hover(false); }
        }
        moved => { if (root.hint-shown) { root.hint-hover(true); } }
    }
}

export component CaptionButton inherits Rectangle {
    in property<string> kind;
    in property<string> label;
    callback clicked();
    width: 46px; height: 32px;
    background: touch.has-hover ? (root.kind == "close" ? #c42b1c : Theme.hover) : transparent;
    animate background { duration: 100ms; }
    accessible-role: button; accessible-label: root.label;
    Path {
        x: (root.width - 16px) / 2; y: (root.height - 16px) / 2; width: 16px; height: 16px;
        viewbox-width: 16; viewbox-height: 16;
        stroke: root.kind == "close" && touch.has-hover ? #ffffff : Theme.text;
        stroke-width: 1.1px; fill: transparent;
        commands: root.kind == "minimize" ? "M 3 8 L 13 8"
            : root.kind == "maximize" ? "M 3 3 L 13 3 L 13 13 L 3 13 Z"
            : root.kind == "restore" ? "M 6 3 L 13 3 L 13 10 M 3 6 L 10 6 L 10 13 L 3 13 Z"
            : root.kind == "compact" ? "M 3 8 L 3 3 L 13 3 L 13 6 M 7 8 L 14 8 L 14 13 L 7 13 Z"
            : "M 3 3 L 13 13 M 13 3 L 3 13";
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    FocusScope { focus-on-click: false; key-pressed(event) => {
        if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; } return reject;
    } }
    Tooltip { text: @markdown("\{root.label}"); }
}

export component ThemeSwatch inherits Rectangle {
    in property<color> swatch;
    in property<bool> selected;
    in property<string> label;
    callback clicked();
    min-width: 32px; preferred-width: 46px; height: 42px;
    horizontal-stretch: 1; background: transparent;
    // Face and outline share one SVG viewport and exactly the same corner
    // centers. A single colored texture replaces the previous four layers.
    Image { x: 0px; y: 0px; width: parent.width; height: parent.height;
        source: root.selected || keys.has-focus ? @image-url("../assets/controls/swatch-selected.svg")
            : @image-url("../assets/controls/swatch-base.svg");
        image-fit: fill;
        colorize: @linear-gradient(135deg, root.swatch.brighter(touch.has-hover ? 16% : 10%) 0%,
            root.swatch 48%, root.swatch.darker(touch.pressed ? 18% : 8%) 100%);
        animate colorize { duration: 130ms; easing: ease-out; }
    }
    Image { x: (parent.width - 24px) / 2; y: (parent.height - 24px) / 2;
        width: 24px; height: 24px;
        source: @image-url("../assets/controls/swatch-marker.svg");
        opacity: root.selected ? 1 : 0;
        animate opacity { duration: 130ms; easing: ease-out; }
    }
    accessible-role: button; accessible-label: root.label; accessible-checked: root.selected;
    forward-focus: keys;
    keys := FocusScope { focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer;
        pointer-event(event) => { if (event.kind == PointerEventKind.down) { keys.focus(); } }
        clicked => { root.clicked(); }
    }
    Tooltip { text: @markdown("\{root.label}"); }
}

export component PreviewButton inherits Rectangle {
    in property<bool> playing: false;
    in property<bool> enabled: true;
    out property<bool> hovered: touch.has-hover;
    callback clicked();
    width: 30px; height: 30px;
    border-radius: self.width / 2;
    border-width: 0.8px;
    border-color: root.playing || touch.has-hover ? Theme.accent-line : Theme.input-line;
    background: touch.pressed ? Theme.pressed : root.playing ? Theme.selection
        : touch.has-hover ? Theme.hover : Theme.control;
    opacity: root.enabled ? 1 : 0.35;
    animate background { duration: 110ms; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.playing ? @tr("停止试听") : @tr("试听");
    accessible-enabled: root.enabled;
    forward-focus: keyboard;
    Path {
        x: (root.width - 14px) / 2; y: (root.height - 14px) / 2;
        width: 14px; height: 14px; viewbox-width: 14; viewbox-height: 14;
        fill: root.playing || touch.has-hover ? Theme.accent-text : Theme.text;
        commands: root.playing ? "M 3 2 L 6 2 L 6 12 L 3 12 Z M 8 2 L 11 2 L 11 12 L 8 12 Z"
            : "M 4 2 L 12 7 L 4 12 Z";
    }
    keyboard := FocusScope {
        focus-on-click: false; enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        pointer-event(event) => { if (event.kind == PointerEventKind.down) { keyboard.focus(); } }
        clicked => { root.clicked(); }
    }
}

export component ActionButton inherits Rectangle {
    in property<string> label;
    in property<int> chevron: 0;
    in property<bool> primary: false;
    in property<bool> quiet: false;
    in property<bool> danger: false;
    in property<bool> enabled: true;
    in property<bool> selected: false;
    in property<bool> navigation: false;
    property<bool> pointer-focus: false;
    private property<float> navigation-hover-opacity: root.navigation && !root.selected && touch.has-hover ? 1 : 0;
    animate navigation-hover-opacity { duration: 110ms; easing: ease-out; }
    out property<bool> hovered: touch.has-hover;
    out property<bool> pressed: touch.pressed;
    in property<length> text-size: Typography.control-size;
    in property<int> text-weight: 400;
    callback clicked();
    min-width: 48px;
    min-height: 36px;
    preferred-height: 40px;
    border-radius: 10px;
    border-width: root.navigation || root.selected || keyboard.has-focus ? 0.75px : root.quiet || root.primary ? 0px : 0.8px;
    border-color: root.selected || (keyboard.has-focus && (!root.navigation || !root.pointer-focus)) ? Theme.accent-line : root.navigation ? transparent : Theme.input-line;
    opacity: root.enabled ? 1 : 0.4;
    // Keep the earlier press/focus protection, and commit tab selection in one
    // frame. Only unselected hover opacity animates; interpolating its opaque
    // tint into a translucent selection tint can create a short color pulse.
    background: root.navigation ? (root.selected ? Theme.selection : Theme.hover.with-alpha(root.navigation-hover-opacity))
        : root.primary ? (touch.pressed ? Theme.accent-pressed : touch.has-hover ? Theme.accent-hover : Theme.accent)
        : touch.pressed ? Theme.pressed : root.selected ? (touch.has-hover ? Theme.selection-hover : Theme.selection)
        : touch.has-hover ? Theme.hover : root.quiet ? transparent : Theme.control;
    animate background { duration: root.navigation ? 0ms : 110ms; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    forward-focus: keyboard;
    Text {
        visible: root.chevron == 0;
        text: root.label;
        font-family: Typography.body-family;
        font-size: root.text-size;
        font-weight: root.text-weight;
        color: root.primary ? Theme.on-accent : root.danger ? Theme.danger : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.chevron != 0: Path {
        x: (root.width - 16px) / 2; y: (root.height - 16px) / 2;
        width: 16px; height: 16px; viewbox-width: 16; viewbox-height: 16;
        stroke: Theme.text; stroke-width: 1.6px; fill: transparent;
        commands: root.chevron < 0 ? "M 10.5 3.5 L 5.5 8 L 10.5 12.5"
            : "M 5.5 3.5 L 10.5 8 L 5.5 12.5";
    }
    keyboard := FocusScope {
        focus-on-click: false;
        enabled: root.enabled;
        changed has-focus => { if (!self.has-focus) { root.pointer-focus = false; } }
        key-pressed(event) => {
            root.pointer-focus = false;
            if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => { if (event.kind == PointerEventKind.down) { root.pointer-focus = true; keyboard.focus(); } }
        clicked => { root.clicked(); }
    }
}

export component Field inherits Rectangle {
    in-out property<string> value;
    callback editing-changed(bool);
    in property<string> placeholder;
    in property<bool> enabled: true;
    height: 44px;
    min-width: 40px;
    background: Theme.control;
    border-radius: 10px;
    border-width: 1px;
    border-color: edit.has-focus ? Theme.accent-line : Theme.input-line;
    accessible-role: text-input;
    accessible-label: root.placeholder;
    forward-focus: edit;
    Text {
        x: 12px; width: parent.width - 24px; height: parent.height;
        text: root.placeholder; color: Theme.faint;
        vertical-alignment: center;
        visible: root.value == "";
    }
    edit := TextInput {
        changed has-focus => { root.editing-changed(self.has-focus); }
        x: 12px; width: parent.width - 24px; height: parent.height;
        text <=> root.value;
        enabled: root.enabled;
        color: Theme.text;
        font-size: 14px;
        vertical-alignment: center;
        single-line: true;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.on-accent;
    }
}

export component NameField inherits Rectangle {
    in-out property<string> value;
    in property<string> placeholder;
    in property<bool> enabled: true;
    in property<[string]> history;
    callback editing-changed(bool);
    callback history-requested(length, length, length);
    property<bool> editing: false;
    property<length> anchor-x: self.absolute-position.x;
    property<length> anchor-y: self.absolute-position.y;
    changed anchor-x => { if (root.editing) { root.request-history(); } }
    changed anchor-y => { if (root.editing) { root.request-history(); } }
    changed width => { if (root.editing) { root.request-history(); } }
    function request-history() {
        if (root.enabled && root.history.length > 0) {
            root.history-requested(root.anchor-x, root.anchor-y, root.width);
        }
    }
    // The edit control always occupies exactly 44px. Suggestions are painted
    // once in the MainWindow overlay, outside all page layouts and clip areas.
    height: 44px; background: transparent;
    forward-focus: name-edit;
    name-edit := Field {
        x: 0px; y: 0px; width: parent.width; height: 44px;
        value <=> root.value; placeholder: root.placeholder; enabled: root.enabled;
        editing-changed(focused) => {
            root.editing = focused;
            root.editing-changed(focused);
            if (focused) { root.request-history(); }
        }
    }
}

export component NameHistoryMenu inherits Rectangle {
    in property<[string]> names;
    callback selected(string);
    callback removed(string);
    // The compact list needs no title or close control: outside clicks and
    // Escape already dismiss it without moving or obscuring the real input.
    height: 16px + min(160px, root.names.length * 40px);
    background: Theme.card;
    border-radius: 12px; border-width: 0.8px; border-color: Theme.line;
    drop-shadow-blur: 9px; drop-shadow-offset-y: 3px;
    drop-shadow-color: Theme.dark ? #00000040 : #30204012;
    ScrollView { x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px;
        horizontal-scrollbar-policy: always-off; mouse-drag-pan-enabled: false; content-width: self.width;
        VerticalLayout { padding: 0px; padding-right: root.names.length > 4 ? 12px : 0px; spacing: 2px;
            for name in root.names: Rectangle {
                height: 38px; border-radius: 7px;
                background: pick.has-hover ? Theme.hover : transparent;
                animate background { duration: 100ms; }
                Image { x: 10px; y: 11px; width: 16px; height: 16px;
                    source: @image-url("../assets/controls/history-clock.svg");
                    colorize: pick.has-hover ? Theme.accent-text : Theme.faint;
                    opacity: pick.has-hover ? 1 : 0.65;
                }
                Text { x: 36px; width: parent.width - 74px; height: parent.height;
                    text: name; color: pick.has-hover ? Theme.accent-text : Theme.muted;
                    font-size: Typography.control-size; overflow: elide; vertical-alignment: center;
                    animate color { duration: 100ms; }
                }
                pick := TouchArea { width: parent.width - 36px; mouse-cursor: pointer;
                    clicked => { root.selected(name); } }
                Rectangle { x: parent.width - 32px; y: 3px; width: 30px; height: 32px; border-radius: 7px;
                    background: remove-name.has-hover ? Theme.danger.with-alpha(0.08) : transparent;
                    accessible-role: button; accessible-label: @tr("删除名称");
                    Image { x: 8px; y: 8px; width: 14px; height: 16px;
                        source: @image-url("../assets/controls/history-delete.svg");
                        colorize: remove-name.has-hover ? Theme.danger : Theme.faint;
                        opacity: remove-name.has-hover ? 1 : 0.4;
                        animate opacity { duration: 100ms; }
                    }
                    remove-name := TouchArea { mouse-cursor: pointer; clicked => { root.removed(name); } }
                    Tooltip { text: @markdown("\{@tr("删除名称")}"); }
                }
            }
        }
    }
}

export component Toggle inherits Rectangle {
    in property<bool> checked;
    in property<string> label;
    in property<bool> enabled: true;
    callback toggled();
    width: 42px; height: 24px;
    background: transparent;
    // SVG alpha masks are rasterized at the physical display size, so capsule
    // and circular edges keep smooth coverage at fractional Windows scaling.
    Image { x: 0px; y: 0px; width: parent.width; height: parent.height;
        source: @image-url("../assets/controls/switch-track.svg");
        colorize: root.checked ? Theme.accent : Theme.line;
        animate colorize { duration: 150ms; }
    }
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    Image {
        x: root.checked ? 21px : 3px;
        y: 3px; width: 18px; height: 18px;
        source: @image-url("../assets/controls/switch-thumb.svg");
        colorize: root.checked ? (Theme.dark ? Theme.on-accent : #ffffff) : Theme.muted;
        animate x { duration: 150ms; easing: ease-out; }
        animate colorize { duration: 150ms; }
    }
    forward-focus: keyboard;
    keyboard := FocusScope { focus-on-click: false; key-pressed(event) => { if (root.enabled && (event.text == " " || event.text == Key.Return)) { root.toggled(); return accept; } return reject; } }
    TouchArea { enabled: root.enabled; mouse-cursor: pointer;
        pointer-event(event) => { if (event.kind == PointerEventKind.down) { keyboard.focus(); } }
        clicked => { root.toggled(); } }
}

export component SelectBox inherits Rectangle {
    in property<[string]> choices;
    in-out property<int> selected;
    in property<bool> enabled: true;
    in property<bool> previewable: false;
    in property<[bool]> sound-available;
    in property<int> playing-index: -1;
    callback changed(int);
    callback preview(int);
    // Commit while the owning control is alive. Closing the popup first destroys
    // the intermediate component referenced by its repeater's weak parent link.
    function choose-option(index: int) {
        if (index >= 0 && index < root.choices.length) {
            root.selected = index;
            root.changed(index);
        }
        menu.close();
    }
    height: 44px; min-width: 100px;
    background: touch.has-hover ? Theme.panel : Theme.control;
    border-radius: 10px;
    border-width: 1px;
    border-color: keyboard.has-focus ? Theme.accent-line : Theme.input-line;
    opacity: root.enabled ? 1 : 0.45;
    Text { x: 12px; width: parent.width - 44px; height: parent.height;
        text: root.selected >= 0 && root.selected < root.choices.length ? root.choices[root.selected] : @tr("请选择");
        color: Theme.text; font-size: Typography.control-size; vertical-alignment: center; overflow: elide;
    }
    Text { x: parent.width - 31px; width: 22px; height: parent.height; text: "\u{E70D}";
        font-family: "Segoe MDL2 Assets"; font-size: 10px; color: Theme.muted; vertical-alignment: center; }
    forward-focus: keyboard;
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer;
        pointer-event(event) => { if (event.kind == PointerEventKind.down) { keyboard.focus(); } }
        clicked => { menu.show(); } }
    keyboard := FocusScope { enabled: root.enabled; focus-on-click: false; key-pressed(event) => {
        if (event.text == " " || event.text == Key.Return) { menu.show(); return accept; }
        if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
            if (root.choices.length > 0) {
                root.choose-option(Math.mod(root.selected + (event.text == Key.DownArrow ? 1 : -1) + root.choices.length, root.choices.length));
            }
            return accept;
        } return reject; } }
    menu := PopupWindow {
        close-policy: close-on-click-outside;
        x: 0px; y: root.height + 5px;
        width: root.width;
        height: min(360px, root.choices.length * 44px + 12px);
        Rectangle {
            background: Theme.card; border-radius: 12px; border-width: 0.8px; border-color: Theme.input-line;
            ScrollView {
                x: 5px; y: 5px; width: parent.width - 10px; height: parent.height - 10px;
                horizontal-scrollbar-policy: always-off;
                mouse-drag-pan-enabled: false;
                content-width: self.width;
                VerticalLayout {
                    spacing: 2px;
                    padding-right: root.choices.length > 8 ? 14px : 0px;
                    for item[index] in root.choices: Rectangle {
                        height: 42px; border-radius: 9px;
                        property<bool> hovered: choose.has-hover || listen.hovered;
                        background: self.hovered ? Theme.selection-hover : index == root.selected ? Theme.selection : transparent;
                        animate background { duration: 140ms; easing: ease-out; }
                        Rectangle { x: 3px; y: 13px; width: 2px; height: 16px; border-radius: 1px;
                            background: Theme.accent; opacity: index == root.selected ? 1 : 0; animate opacity { duration: 120ms; } }
                        Text { x: parent.hovered ? 15px : 12px; y: 0px;
                            width: parent.width - (root.previewable ? 54px : 25px); height: parent.height;
                            text: item; color: Theme.text; vertical-alignment: center; overflow: elide; font-size: Typography.control-size;
                            animate x { duration: 110ms; easing: ease-out; } }
                        forward-focus: choice-focus;
                        choice-focus := FocusScope { focus-on-click: false; key-pressed(event) => {
                            if (event.text == Key.Return || event.text == " ") {
                                root.choose-option(index); return accept;
                            } return reject; } }
                        choose := TouchArea {
                            width: parent.width - (root.previewable ? 46px : 0px); mouse-cursor: pointer;
                            pointer-event(event) => { if (event.kind == PointerEventKind.down) { choice-focus.focus(); } }
                            clicked => { root.choose-option(index); }
                        }
                        listen := PreviewButton {
                            x: parent.width - 38px; y: 6px;
                            visible: root.previewable;
                            enabled: index > 0 && index < root.sound-available.length && root.sound-available[index];
                            playing: root.playing-index == index;
                            clicked => { root.preview(index); }
                        }
                    }
                }
            }
        }
    }
}

export component Wheel inherits Rectangle {
    in-out property<int> value;
    in property<int> limit: 60;
    in property<string> label;
    property<length> drag-y;
    property<int> drag-value;
    property<bool> dragged;
    height: 180px; min-width: 68px;
    background: Theme.panel;
    border-radius: 12px;
    clip: true;
    accessible-role: slider;
    accessible-label: root.label;
    forward-focus: keyboard;
    Rectangle { x: 3px; y: 72px; width: parent.width - 6px; height: 36px; border-radius: 8px; background: Theme.selection; }
    for row in 5: Text {
        property<int> number: Math.mod(root.value + row - 2 + root.limit * 4, root.limit);
        x: 0px; y: row * 36px; width: parent.width; height: 36px;
        text: self.number < 10 ? "0\{self.number}" : "\{self.number}";
        color: row == 2 ? Theme.accent-text : row == 1 || row == 3 ? Theme.muted : Theme.faint;
        font-family: "Bahnschrift";
        font-size: row == 2 ? 28px : 22px;
        font-weight: row == 2 ? 600 : 400;
        horizontal-alignment: center; vertical-alignment: center;
    }
    keyboard := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.UpArrow) { root.value = Math.mod(root.value - 1 + root.limit, root.limit); return accept; }
            if (event.text == Key.DownArrow) { root.value = Math.mod(root.value + 1, root.limit); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) { root.drag-y = self.mouse-y; root.drag-value = root.value; root.dragged = false; keyboard.focus(); }
        }
        moved => {
            if (self.pressed && Math.abs(self.mouse-y - root.drag-y) > 4px) {
                root.dragged = true;
                root.value = Math.mod(root.drag-value - Math.round((self.mouse-y - root.drag-y) / 36px) + root.limit * 100, root.limit);
            }
        }
        clicked => { if (!root.dragged) { root.value = Math.mod(root.value + Math.floor(self.mouse-y / 36px) - 2 + root.limit * 4, root.limit); } }
        scroll-event(event) => {
            if (event.delta-y != 0px) { root.value = Math.mod(root.value + (event.delta-y < 0px ? 1 : -1) + root.limit, root.limit); }
            return accept;
        }
    }
}

export component TimePicker inherits Rectangle {
    in-out property<int> hour;
    in-out property<int> minute;
    in-out property<int> second;
    in property<int> hour-limit: 24;
    in property<bool> with-seconds: false;
    in property<bool> large: false;
    property<int> draft-hour;
    property<int> draft-minute;
    property<int> draft-second;
    callback changed();
    function open-picker() {
        root.draft-hour = root.hour;
        root.draft-minute = root.minute;
        root.draft-second = root.second;
        picker.show();
    }
    function accept-time() {
        root.hour = root.draft-hour;
        root.minute = root.draft-minute;
        root.second = root.draft-second;
        root.changed();
        picker.close();
    }
    height: root.large ? 88px : 44px;
    background: root.large ? transparent : Theme.control;
    border-radius: 10px;
    border-width: root.large ? 0px : 1px;
    border-color: touch.has-hover ? Theme.accent-line : Theme.input-line;
    property<string> hour-text: root.hour < 10 ? "0\{root.hour}" : "\{root.hour}";
    property<string> minute-text: root.minute < 10 ? "0\{root.minute}" : "\{root.minute}";
    property<string> second-text: root.second < 10 ? "0\{root.second}" : "\{root.second}";
    Text {
        text: root.with-seconds ? root.hour-text + ":" + root.minute-text + ":" + root.second-text : root.hour-text + ":" + root.minute-text;
        color: Theme.text;
        font-family: "Bahnschrift";
        font-weight: 300;
        font-size: root.large ? (root.with-seconds ? 58px : 68px) : 20px;
        letter-spacing: root.large ? 1px : 0px;
        horizontal-alignment: center; vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => { if (event.kind == PointerEventKind.down) { keyboard.focus(); } }
        clicked => { root.open-picker(); }
    }
    forward-focus: keyboard;
    keyboard := FocusScope { focus-on-click: false; key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { root.open-picker(); return accept; } return reject; } }
    picker := PopupWindow {
        close-policy: close-on-click-outside;
        x: (root.width - 300px) / 2;
        y: root.height + 4px;
        width: 300px; height: 304px;
        Rectangle {
            background: Theme.card; border-radius: 16px; border-width: 0.8px; border-color: Theme.accent-line;
            VerticalLayout {
                padding: 16px; spacing: 12px;
                Text { text: @tr("滑动选择时间"); color: Theme.muted; font-size: 12px; height: 18px; }
                HorizontalLayout {
                    spacing: 8px;
                    Wheel { value <=> root.draft-hour; limit: root.hour-limit; label: @tr("小时"); }
                    Wheel { value <=> root.draft-minute; label: @tr("分钟"); }
                    if root.with-seconds: Wheel { value <=> root.draft-second; label: @tr("秒"); }
                }
                HorizontalLayout {
                    spacing: 8px;
                    ActionButton { label: @tr("取消"); clicked => { picker.close(); } }
                    ActionButton { label: @tr("确定"); primary: true; clicked => { root.accept-time(); } }
                }
            }
        }
    }
}

export component DurationPicker inherits Rectangle {
    in-out property<int> seconds;
    in property<int> max-seconds: 5999;
    in property<bool> allow-zero: false;
    property<int> draft-minute;
    property<int> draft-second;
    callback changed();
    height: 44px; min-width: 80px;
    background: Theme.control; border-radius: 10px; border-width: 0.8px;
    border-color: duration-touch.has-hover ? Theme.accent-line : Theme.input-line;
    property<int> minutes: Math.floor(root.seconds / 60);
    property<int> seconds-part: Math.mod(root.seconds, 60);
    Text {
        text: (root.minutes < 10 ? "0" : "") + root.minutes + ":" + (root.seconds-part < 10 ? "0" : "") + root.seconds-part;
        font-family: "Bahnschrift"; font-size: 20px; font-weight: 300;
        color: Theme.text; horizontal-alignment: center; vertical-alignment: center;
    }
    function open-picker() {
        root.draft-minute = root.minutes; root.draft-second = root.seconds-part; duration-popup.show();
    }
    forward-focus: duration-keys;
    duration-keys := FocusScope { focus-on-click: false; key-pressed(event) => {
        if (event.text == Key.Return || event.text == " ") { root.open-picker(); return accept; } return reject;
    } }
    duration-touch := TouchArea { mouse-cursor: pointer;
        pointer-event(event) => { if (event.kind == PointerEventKind.down) { duration-keys.focus(); } }
        clicked => { root.open-picker(); }
    }
    duration-popup := PopupWindow {
        close-policy: close-on-click-outside;
        x: (root.width - 280px) / 2; y: root.height + 4px;
        width: 280px; height: 320px;
        Rectangle { background: Theme.card; border-radius: 16px; border-width: 0.8px; border-color: Theme.accent-line;
            VerticalLayout { padding: 16px; spacing: 12px;
                Text { text: @tr("滑动选择时长"); color: Theme.muted; font-size: 12px; height: 18px; }
                HorizontalLayout { spacing: 10px;
                    VerticalLayout { spacing: 4px;
                        Text { text: @tr("分钟"); color: Theme.faint; font-size: 11px; horizontal-alignment: center; height: 16px; }
                        Wheel { value <=> root.draft-minute; limit: Math.floor(root.max-seconds / 60) + 1; label: @tr("分钟"); }
                    }
                    VerticalLayout { spacing: 4px;
                        Text { text: @tr("秒"); color: Theme.faint; font-size: 11px; horizontal-alignment: center; height: 16px; }
                        Wheel { value <=> root.draft-second; limit: root.draft-minute * 60 >= root.max-seconds ? 1 : 60; label: @tr("秒"); }
                    }
                }
                HorizontalLayout { spacing: 8px; height: 36px;
                    ActionButton { label: @tr("取消"); clicked => { duration-popup.close(); } }
                    ActionButton { label: @tr("确定"); primary: true; clicked => {
                        root.seconds = max(root.allow-zero ? 0 : 1, min(root.max-seconds, root.draft-minute * 60 + root.draft-second));
                        root.changed(); duration-popup.close();
                    } }
                }
            }
        }
    }
}

// Missing bold faces are synthesized by the glyph rasterizer in a single mask.
export component EmphasisText inherits Text {
    font-weight: Typography.emphasis-weight;
}

export component SectionTitle inherits EmphasisText {
    color: Theme.text; font-size: Typography.heading-size; font-weight: Typography.emphasis-weight;
    height: 26px; vertical-alignment: center;
}

export component Panel inherits Rectangle {
    background: Theme.card;
    border-color: Theme.line; border-width: 0.8px; border-radius: 18px;
}

